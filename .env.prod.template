# Aimbase 운영 .env 템플릿
# 사용법: cp .env.prod.template .env → 실제 값 채운 후 서버로 scp
# 주의: 실제 값이 채워진 .env 파일은 git에 커밋하지 말 것 (.gitignore 확인)

# ── Server ──
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── Master DB (테넌트 레지스트리) ──
MASTER_DB_URL=jdbc:postgresql://host.docker.internal:5432/aimbase_master
MASTER_DB_USERNAME=platform
MASTER_DB_PASSWORD=<CHANGE_ME>

# ── Tenant DB 기본값 ──
TENANT_DB_HOST=host.docker.internal
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=platform
TENANT_DB_PASSWORD=<CHANGE_ME>

# ── Redis ──
SPRING_REDIS_HOST=host.docker.internal
SPRING_REDIS_PORT=6379

# ── Security (운영용: `openssl rand -base64 48` 등으로 생성) ──
JWT_SECRET=<CHANGE_ME_RANDOM_48_CHARS>
ENCRYPTION_KEY=<CHANGE_ME_RANDOM_32_CHARS>

# ── Python Sidecar (RAG) DB 접속 ──
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=aimbase_axopm_companya
DB_USER=platform
DB_PASSWORD=<CHANGE_ME>
