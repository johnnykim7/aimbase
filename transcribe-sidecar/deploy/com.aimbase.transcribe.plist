<?xml version="1.0" encoding="UTF-8"?>
<!--
  맥 상주 설정 견본. 직접 복사하지 않고 deploy/install-mac.sh 로 설치한다.
  스크립트가 __TARGET__ 을 실행본 폴더(기본 ~/Server/transcribe-sidecar)로 바꾼다.
  launchd 가 띄운 프로세스는 ~/Documents 를 읽지 못해 저장소 안 경로로는 뜨지 않는다.

  로그인 세션에 묶이므로 맥이 잠자기로 들어가면 멈춘다.
  배치가 야간에 돌아야 하면 시스템설정에서 잠자기를 해제할 것.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aimbase.transcribe</string>

    <key>ProgramArguments</key>
    <array>
        <string>__TARGET__/run.sh</string>
    </array>

    <!-- 모델 캐시(./mlx_models)가 CWD 기준이라 반드시 고정한다. -->
    <key>WorkingDirectory</key>
    <string>__TARGET__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__TARGET__/logs/sidecar.log</string>
    <key>StandardErrorPath</key>
    <string>__TARGET__/logs/sidecar.log</string>
</dict>
</plist>
