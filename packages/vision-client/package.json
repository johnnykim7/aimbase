{
  "name": "@aimbase/vision-client",
  "version": "0.1.0",
  "description": "Aimbase Vision Client — upload video, get VLM analysis (CR-137). No UI, upload reliability only.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "aimbase",
    "vision",
    "vlm",
    "video",
    "frame-extraction"
  ],
  "license": "UNLICENSED",
  "private": true
}
